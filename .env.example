# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=SpendSense

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional for Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Groq AI (Required for Insights, Receipt Scanning & Transaction Categorization)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Cloudinary (Receipt image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis for BullMQ Ingestion Worker (Optional for dev with inline fallback, required for worker)
REDIS_URL=redis://localhost:6379

# Dedicated Isolated Test Database & Test Redis (Required for isolated integration test suite)
MONGODB_TEST_URI=mongodb+srv://username:password@cluster.mongodb.net/spendsense_test?appName=SpendSense
REDIS_TEST_URL=redis://localhost:6379/1

